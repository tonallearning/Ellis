# Site
# Local dev: http://localhost:3000 · Production: https://tybuilds.tech
NEXT_PUBLIC_SITE_URL=https://tybuilds.tech

# Ellis mode: onboarding (Ty-only) | public (after Ty approves about-ty/*)
ELLIS_MODE=onboarding

# Gate for /onboarding. The same secret marks Ty as owner: a long-lived
# cookie and a memory row that is not an IP hash, so the household
# connection cannot inherit her recall. Required in production.
ELLIS_ONBOARDING_SECRET=

# Footer contact (Phase C)
# NEXT_PUBLIC_CONTACT_EMAIL=

# Anthropic — Phase B (server only; never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
ELLIS_MODEL_HAIKU=claude-haiku-4-5-20251001
ELLIS_MODEL_SONNET=claude-sonnet-4-20250514

# Supabase — GoE project (oubavruicijhxiqrlikr); ellis_usage table only
# Copy from GoE → Settings → API. Service role is server-only (Vercel, never NEXT_PUBLIC_).
# Apply migration: see supabase/README.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rate limits — Phase B public mode only (not needed for onboarding)
# ELLIS_DAILY_BUDGET_USD=1
# ELLIS_MAX_MESSAGE_CHARS=12000
# ELLIS_MAX_HISTORY_MESSAGES=30

# Required in production. Visitor IPs are stored only as SHA-256(ip + salt), and
# IPv4 is small enough to enumerate, so a leaked or guessable salt makes every
# stored hash reversible. Production refuses to hash without a real one.
# Generate with: openssl rand -hex 32
ELLIS_IP_HASH_SALT=

# Visitor recall decay cron (vercel.json runs it daily at 00:00 UTC).
# Vercel sends this as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=
