# Site
# Local dev: http://localhost:3000 · Production: https://tybuilds.tech
NEXT_PUBLIC_SITE_URL=https://tybuilds.tech

# Ellis mode: onboarding (Ty-only) | public (after Ty approves about-ty/*)
ELLIS_MODE=onboarding

# Optional gate for onboarding route in preview/production
ELLIS_ONBOARDING_SECRET=

# Footer contact (Phase C)
# NEXT_PUBLIC_CONTACT_EMAIL=

# Anthropic — Phase B (server only; never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
ELLIS_MODEL_HAIKU=claude-haiku-4-5-20251001
ELLIS_MODEL_SONNET=claude-sonnet-4-20250514

# Supabase — GoE project (oubavruicijhxiqrlikr); ellis_usage table only
# Copy from GoE → Settings → API. Service role is server-only (Vercel, never NEXT_PUBLIC_).
# Apply migration: see supabase/README.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rate limits — Phase B public mode only (not needed for onboarding)
# ELLIS_DAILY_BUDGET_USD=1
# ELLIS_MAX_MESSAGE_CHARS=12000
# ELLIS_MAX_HISTORY_MESSAGES=30
